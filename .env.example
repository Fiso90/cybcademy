# CybCademy — Environment Configuration
# Copy to .env and fill in real values. Never commit the real .env file.

APP_NAME=CybCademy
APP_ENV=production
APP_KEY=                          # generate via `php artisan key:generate`
APP_DEBUG=false                   # MUST be false in production - Phase 7 Section 2, A05
APP_URL=https://app.cybcademy.example

# --- Database (PostgreSQL 16, managed/external host - see docker-compose.yml's top comment) ---
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=cybcademy
DB_USERNAME=cybcademy_app          # the least-privileged runtime role referenced in the audit_logs migration (Epic E1) - NOT a superuser
DB_PASSWORD=

# --- Redis (sessions, cache, queues) ---
# Single instance for v1.0 per Phase 4's confirmed architecture - flagged
# there as a scaling risk to revisit post-GA (separate instances per
# concern) if contention becomes measurable.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# --- File storage (S3-compatible / Cloudflare R2, per Phase 4 Section 10) ---
FILESYSTEM_DISK=private
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=cybcademy-production
AWS_ENDPOINT=                      # Cloudflare R2 endpoint URL
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- AI (Epic E9 - AiGatewayService) ---
ANTHROPIC_API_KEY=
ANTHROPIC_API_VERSION=2023-06-01
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Mail (referenced by Epic E10's NotificationService delivery-channel gap, and Epic E1's invitation emails) ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@cybcademy.example
MAIL_FROM_NAME="${APP_NAME}"

# --- Sanctum (Epic E1 - session/JWT auth split) ---
SANCTUM_STATEFUL_DOMAINS=app.cybcademy.example

# --- Malware scanning (Phase 7 Section 14 - flagged as unselected tooling every epic since Phase 7) ---
# CLAMAV_HOST=
# CLAMAV_PORT=3310
